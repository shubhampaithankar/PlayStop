{
  "name": "@playstop/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./dist/*"
  },
  "scripts": {
    "dev": "pnpm run \"/^dev:/\"",
    "dev:build": "tsc -w -p tsconfig.json",
    "dev:serve": "node --watch --env-file=.env dist/server.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test --test-concurrency=1 --env-file-if-exists=.env dist/",
    "seed": "node --env-file-if-exists=.env dist/seed.js"
  },
  "dependencies": {
    "@playstop/engine": "workspace:*",
    "@playstop/types": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "luxon": "^3.7.2",
    "mongodb": "^7.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.1",
    "@types/node": "^26.1.2"
  }
}
