{
  "name": "@playstop/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#testing-support.js": "./dist-tests/tests/testing-support.js",
    "#*": "./dist/*"
  },
  "scripts": {
    "dev": "pnpm run \"/^dev:/\"",
    "dev:build": "tsc -w -p tsconfig.json",
    "dev:serve": "node --watch --env-file=.env dist/main.js",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "node -e \"require('node:fs').rmSync('dist-tests',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && tsc --noEmit",
    "test": "node -e \"require('node:fs').rmSync('dist-tests',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && pnpm build && node --test --test-concurrency=1 --env-file-if-exists=.env dist/",
    "seed": "node --env-file-if-exists=.env dist/seed.js"
  },
  "dependencies": {
    "@playstop/engine": "workspace:*",
    "@playstop/types": "workspace:*",
    "@sentry/node": "^10.69.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "luxon": "^3.7.2",
    "mongodb": "^7.5.0",
    "morgan": "^1.11.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.1",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.2"
  }
}
