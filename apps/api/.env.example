PORT=3001
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
# Atlas gives two connection string forms. Prefer the mongodb+srv:// one.
# If local dev fails with 'querySrv ECONNREFUSED', Node's DNS resolver cannot
# read your Windows DNS config. Use Atlas's long-form string instead:
# mongodb://user:pass@host1:27017,host2:27017,host3:27017/?ssl=true&replicaSet=...&authSource=admin
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=playstop_dev
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379
HOLD_TTL_SECONDS=300
# Upstash from outside Singapore measures a ~357ms p99; a 500ms default
# leaves local dev on the edge of degraded mode, so raise it here.
REDIS_COMMAND_TIMEOUT_MS=2000
APP_ENV=dev
# Optional. Leave commented out for local dev: Sentry.init with no DSN is a
# no-op. An empty string fails validation, so don't set the key at all.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
SENTRY_TRACES_SAMPLE_RATE=0.1
