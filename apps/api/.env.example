PORT=3001
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
# Atlas gives two connection string forms. Prefer the mongodb+srv:// one.
# If local dev fails with 'querySrv ECONNREFUSED', Node's DNS resolver cannot
# read your Windows DNS config. Use Atlas's long-form string instead:
# mongodb://user:pass@host1:27017,host2:27017,host3:27017/?ssl=true&replicaSet=...&authSource=admin
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/playstop_dev?retryWrites=true&w=majority
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379
HOLD_TTL_SECONDS=300
